# Use the same-origin proxy in production so auth cookies stay first-party.
VITE_API_URL=/api
VITE_API_PROXY=http://localhost:4000

# Firebase Web SDK configuration. Keep these values out of source files.
# The Firebase Web API key is client-visible by design; protect access with
# Firebase Authentication and project security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
